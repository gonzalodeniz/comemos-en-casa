# Copia este fichero como .env y reemplaza los marcadores antes de iniciar Compose.
# Valores solo para desarrollo; no reutilices estas credenciales en producción.
POSTGRES_USER=comemos
POSTGRES_DB=comemos
POSTGRES_PASSWORD=replace-with-a-local-development-password
AUTH_RATE_LIMIT_HMAC_KEY=replace-with-64-hex-characters
APP_PUBLIC_URL=https://gonzalodeniz.com/comemos
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://gonzalodeniz.com

# Opcional: sin configuración SMTP, los correos de restablecimiento no se entregan.
EMAIL_SMTP_HOST=mailhog
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=Comemos en casa <no-reply@localhost>
EMAIL_SMTP_STARTTLS=false

# Let's Encrypt notification email is intentionally unset; issuance uses --register-unsafely-without-email.
